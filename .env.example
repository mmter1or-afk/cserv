# Flask Configuration
FLASK_ENV=production
DEBUG=False

# Admin Configuration (for app.py only - can be ignored if using server.py with database)
ADMIN_USER=admin
ADMIN_PASS=change-me-in-production

# Database (for server.py)
DATABASE_PATH=/opt/cheat-server/database.db

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=86400

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=2
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif

# Security
RATE_LIMIT_ENABLED=True
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=300
